# shellcheck shell=bash
# Sourced by the Stardew Valley scripts after GAMEDIR is set.
#
# GAMEDIR holds the port itself (scripts, tools, .NET, native helpers).
# DATADIR holds everything that's written: game files, downloads, mods,
# logs and the controller mapping. For the zip package they're the same
# folder. A Haiku package (.hpkg) installs GAMEDIR read-only, so DATADIR
# moves to the user's data folder. SDV_DATA_DIR overrides it.
if [ -n "${SDV_DATA_DIR:-}" ]; then
  DATADIR="$SDV_DATA_DIR"
elif [ -f "$GAMEDIR/.packaged" ]; then
  DATADIR="$(finddir B_USER_DATA_DIRECTORY 2>/dev/null || echo "$HOME/config/data")/StardewValley"
else
  DATADIR="$GAMEDIR"
fi
# Read by the scripts that source this file.
if [ -f "$GAMEDIR/.packaged" ]; then export PACKAGED=1; else export PACKAGED=0; fi
mkdir -p "$DATADIR"
