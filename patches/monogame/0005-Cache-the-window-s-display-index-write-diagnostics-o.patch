diff --git a/MonoGame.Framework/DiagnosticsFile.cs b/MonoGame.Framework/DiagnosticsFile.cs
new file mode 100644
index 000000000..efe7aadc8
--- /dev/null
+++ b/MonoGame.Framework/DiagnosticsFile.cs
@@ -0,0 +1,96 @@
+// MonoGame - Copyright (C) The MonoGame Team
+// This file is subject to the terms and conditions defined in
+// file 'LICENSE.txt', which is part of this source code package.
+
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.IO;
+using System.Threading;
+
+namespace Microsoft.Xna.Framework
+{
+    /// <summary>
+    /// Appends lines to the diagnostics CSV files on a background thread.
+    /// </summary>
+    /// <remarks>
+    /// Opening, writing and closing a file for every sample took tens of
+    /// milliseconds per frame on some systems (Haiku), so the profilers
+    /// distorted the frame times they measured. Callers only queue a string;
+    /// the files stay open and are flushed whenever the queue runs empty.
+    /// </remarks>
+    internal static class DiagnosticsFile
+    {
+        private struct Entry
+        {
+            public string Path;
+            public string Header;
+            public string Line;
+        }
+
+        private static readonly BlockingCollection<Entry> Queue = new BlockingCollection<Entry>();
+        private static readonly object StartLock = new object();
+        private static Thread _writerThread;
+
+        internal static void AppendLine(string path, string header, string line)
+        {
+            if (_writerThread == null)
+            {
+                lock (StartLock)
+                {
+                    if (_writerThread == null)
+                    {
+                        var thread = new Thread(WriteLoop) { IsBackground = true, Name = "Diagnostics writer" };
+                        thread.Start();
+                        _writerThread = thread;
+                    }
+                }
+            }
+
+            Queue.Add(new Entry { Path = path, Header = header, Line = line });
+        }
+
+        private static void WriteLoop()
+        {
+            var writers = new Dictionary<string, StreamWriter>();
+            var failed = new HashSet<string>();
+            foreach (var entry in Queue.GetConsumingEnumerable())
+            {
+                if (failed.Contains(entry.Path))
+                    continue;
+
+                try
+                {
+                    StreamWriter writer;
+                    if (!writers.TryGetValue(entry.Path, out writer))
+                    {
+                        var directory = Path.GetDirectoryName(entry.Path);
+                        if (!string.IsNullOrEmpty(directory))
+                            Directory.CreateDirectory(directory);
+
+                        var needsHeader = !File.Exists(entry.Path) || new FileInfo(entry.Path).Length == 0;
+                        var stream = new FileStream(entry.Path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite, 65536);
+                        writer = new StreamWriter(stream);
+                        writers[entry.Path] = writer;
+                        if (needsHeader && entry.Header != null)
+                            writer.WriteLine(entry.Header);
+                    }
+
+                    writer.WriteLine(entry.Line);
+
+                    // The game is usually ended with SIGKILL, so don't sit on data.
+                    if (Queue.Count == 0)
+                    {
+                        foreach (var w in writers.Values)
+                            w.Flush();
+                    }
+                }
+                catch (Exception ex)
+                {
+                    failed.Add(entry.Path);
+                    Console.Out.WriteLine("Diagnostics log disabled for {0}: {1}", entry.Path, ex.Message);
+                }
+            }
+        }
+    }
+}
